{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mini-racer",
  "permissions": {
    "reddit": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "height": "tall",
        "entry": "preview.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Mini Racer post",
        "description": "Publish a playable Mini Racer game post in this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "mini_racer_dev"
  }
}