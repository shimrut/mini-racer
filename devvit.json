{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mini-racer",
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "permissions": {
    "journeys": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "height": "tall",
        "entry": "preview.html"
      },
      "game": {
        "entry": "game.html"
      },
      "campaign-challenge": {
        "height": "tall",
        "entry": "campaign-challenge.html"
      },
      "podium": {
        "height": "tall",
        "entry": "podium.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Mini Racer post",
        "description": "Publish a playable Mini Racer game post in this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Enable daily Mini Racer posts",
        "description": "Create a new Mini Racer custom post every UTC day for the featured track",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-enable-daily"
      },
      {
        "label": "Disable daily Mini Racer posts",
        "description": "Stop creating daily Mini Racer custom posts for this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-disable-daily"
      },
      {
        "label": "Enable daily Mini Racer podium posts",
        "description": "Publish the final podium when a track leaves the seven-day window",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/podium-enable-daily"
      },
      {
        "label": "Disable daily Mini Racer podium posts",
        "description": "Stop publishing final Mini Racer podium posts for this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/podium-disable-daily"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily-mini-racer-posts": {
        "endpoint": "/internal/scheduler/daily-posts",
        "cron": "5 0 * * *"
      },
      "daily-mini-racer-podium-posts": {
        "endpoint": "/internal/scheduler/daily-podium-posts",
        "cron": "1 * * * *"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "mini_racer_dev"
  }
}
