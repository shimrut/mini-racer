{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mini-racer",
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "sourceIgnores": [
    "**/.DS_Store",
    ".agents/",
    ".claude/",
    ".cursor/",
    ".vscode/",
    ".gitignore",
    "CHANGELOG.md",
    "FAQ.md",
    "LP/",
    "README.md",
    "assets/share/",
    "docs/",
    "site/",
    "stryker.config.mjs",
    "tests/",
    "tools/*",
    "!tools/mapmaker.js",
    "!tools/mapmaker-playtest.js",
    "!tools/mapmaker.css",
    "!tools/mapmaker-playtest.css",
    "!tools/geometry.js",
    "!tools/mapmaker/",
    "!tools/mapmaker/**",
    "!tools/generate-player-car-assets.js",
    "!tools/generate-share-images.js",
    "vite.mapmaker.config.js",
    "vitest.config.js"
  ],
  "permissions": {
    "journeys": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBMIT_POST"
      ]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "height": "tall",
        "entry": "pages/preview.html"
      },
      "daily": {
        "height": "tall",
        "entry": "pages/daily.html"
      },
      "game": {
        "entry": "pages/game.html"
      },
      "campaign": {
        "height": "tall",
        "entry": "pages/campaign.html"
      },
      "head-to-head": {
        "height": "tall",
        "entry": "pages/head-to-head.html"
      },
      "podium": {
        "height": "tall",
        "entry": "pages/podium.html"
      },
      "mod-analytics": {
        "height": "tall",
        "entry": "pages/mod-analytics.html"
      },
      "map-creator": {
        "height": "tall",
        "entry": "pages/map-creator.html"
      },
      "map-creator-playtest": {
        "height": "tall",
        "entry": "pages/map-creator-playtest.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Mini Racer post",
        "description": "Publish a frozen Daily challenge post in this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create current Daily launcher",
        "description": "Publish one post that always shows today's featured track",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/launcher-daily-create"
      },
      {
        "label": "Create Campaign launcher",
        "description": "Publish one post that opens Mini Racer in Campaign mode",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/launcher-campaign-create"
      },
      {
        "label": "Create Lobby launcher",
        "description": "Publish one post that opens the Mini Racer lobby",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/launcher-lobby-create"
      },
      {
        "label": "Enable daily Mini Racer posts",
        "description": "Create a new Mini Racer custom post every UTC day for the featured track",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-enable-daily"
      },
      {
        "label": "Disable daily Mini Racer posts",
        "description": "Stop creating daily Mini Racer custom posts for this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-disable-daily"
      },
      {
        "label": "Enable daily Mini Racer podium posts",
        "description": "Publish the final podium when a track leaves the seven-day window",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/podium-enable-daily"
      },
      {
        "label": "Disable daily Mini Racer podium posts",
        "description": "Stop publishing final Mini Racer podium posts for this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/podium-disable-daily"
      },
      {
        "label": "Collect Mini Racer challenges",
        "description": "Save existing Challenge posts so Change Track can send players to another race",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/head-to-head-catalog-sweep"
      },
      {
        "label": "Open Mini Racer analytics",
        "description": "Open the moderator-only unique player and race summary",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mod-analytics-open"
      },
      {
        "label": "Open Mini Racer Creator",
        "description": "Make and publish desktop Community maps",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/community-creator-open"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily-mini-racer-posts": {
        "endpoint": "/internal/scheduler/daily-posts",
        "cron": "5 0 * * *"
      },
      "daily-mini-racer-podium-posts": {
        "endpoint": "/internal/scheduler/daily-podium-posts",
        "cron": "1 * * * *"
      },
      "mini-racer-raced-list-fill": {
        "endpoint": "/internal/scheduler/raced-list-fill",
        "cron": "* * * * *"
      }
    }
  },
  "scripts": {
    "build": "npm run build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "mini_racer_dev"
  }
}
