{
  "name": "mini-racer",
  "private": true,
  "type": "module",
  "scripts": {
    "analytics:css": "tailwindcss -i tools/analytics-dashboard.tailwind.css -o tools/analytics-dashboard.css --minify",
    "generate:car-assets": "node tools/generate-player-car-assets.js",
    "build": "npm run generate:car-assets && vite build",
    "deploy": "npm run test && npm run build && devvit upload",
    "dev": "devvit playtest",
    "analytics:dashboard": "npm run analytics:css && node tools/analytics-dashboard-server.js",
    "launch": "npm run deploy && devvit publish",
    "login": "devvit login",
    "predev": "npm run generate:car-assets",
    "pretest": "npm run generate:car-assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "stryker run",
    "mutation:dry-run": "stryker run --dryRunOnly"
  },
  "dependencies": {
    "@devvit/server": "0.13.6",
    "@devvit/start": "0.13.6",
    "@devvit/web": "0.13.6",
    "chart.js": "^4.5.1",
    "devvit": "0.13.6",
    "express": "^5.1.0",
    "flatpickr": "^4.6.13"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vite": "7.3.1",
    "vitest": "^3.1.1"
  }
}
