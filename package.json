{
  "name": "mini-racer",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:car-assets": "node tools/generate-player-car-assets.js",
    "generate:lp-assets": "node tools/generate-lp-assets.js",
    "generate:share-images": "node tools/generate-share-images.js",
    "build": "npm run generate:car-assets && npm run generate:share-images && vite build && node tools/bust-client-asset-cache.js",
    "deploy": "npm run test && npm run build && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "login": "devvit login",
    "mapmaker": "vite --config vite.mapmaker.config.js --host 127.0.0.1",
    "predev": "npm run generate:car-assets && npm run generate:share-images",
    "pretest": "npm run generate:car-assets && npm run generate:share-images",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "stryker run",
    "mutation:dry-run": "stryker run --dryRunOnly"
  },
  "dependencies": {
    "@devvit/analytics": "0.13.9",
    "@devvit/redis": "0.13.9",
    "@devvit/web": "0.13.9",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "devDependencies": {
    "@devvit/start": "0.13.9",
    "@napi-rs/canvas": "^1.0.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "devvit": "0.13.9",
    "vite": "7.3.6",
    "vitest": "^3.1.1"
  }
}
