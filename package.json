{
  "name": "mini-racer",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:car-assets": "node tools/generate-player-car-assets.js",
    "generate:lp-assets": "node tools/generate-lp-assets.js",
    "generate:share-images": "node tools/generate-share-images.js",
    "analyze:css": "node tools/analyze-unused-css.js",
    "build": "npm run generate:car-assets && npm run generate:share-images && vite build",
    "deploy": "npm run test && devvit upload",
    "dev": "trap 'npm run --silent kill:watchers' EXIT INT TERM; devvit playtest",
    "kill:watchers": "pkill -f \"$PWD/node_modules/.bin/vite build --watch\" 2>/dev/null || true",
    "launch": "npm run test && devvit publish",
    "login": "devvit login",
    "mapmaker": "vite --config vite.mapmaker.config.js --host 127.0.0.1",
    "build:site": "node tools/build-site.js",
    "deploy:site": "npm run build:site && npx -y wrangler@latest pages deploy --cwd site --project-name miniracer --branch main",
    "predev": "npm run --silent kill:watchers && npm run generate:car-assets && npm run generate:share-images",
    "pretest": "npm run typecheck && npm run generate:car-assets && npm run generate:share-images",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "mutation": "stryker run",
    "mutation:dry-run": "stryker run --dryRunOnly"
  },
  "dependencies": {
    "@devvit/analytics": "0.14.5",
    "@devvit/redis": "0.14.5",
    "@devvit/web": "0.14.5",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "devDependencies": {
    "@devvit/start": "0.14.5",
    "@napi-rs/canvas": "^1.0.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "devvit": "0.14.5",
    "vite": "7.3.6",
    "vitest": "^3.1.1"
  }
}
